<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Historical Explorer</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="m-0 d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark" style="background:#111;">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold letter-spaced" href="/">&#9670; Historical Explorer</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto" id="nav-era-links">
                    <!-- Era links injected by script.js when on the home page -->
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-outline-light btn-sm ms-3 fw-bold" href="/Admin" style="border-radius:20px;">⚙️ Admin</a>
                    <a class="btn btn-outline-secondary btn-sm ms-2" href="/Admin/Logout" style="border-radius:20px;">Sign out</a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="text-center py-4 mt-auto">
        <p class="text-muted small mb-0">Designed by Bahaa &amp; Buse</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
