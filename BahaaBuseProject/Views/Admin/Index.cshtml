/* quiz crud */
async function promptAddQuiz(eraId){
    const question=prompt('Question text:');if(!question)return;
    const opts=[];
    for(let i=1;i<=4;i++){
        const o=prompt(`Option ${i}:`);if(!o)return;
        opts.push({text:o});
    }
    const correct=parseInt(prompt('Which option is correct? (1, 2, 3, or 4):'))-1;
    if(isNaN(correct)||correct<0||correct>3){alert('Invalid option number.');return;}
    const payload={eraId,question,correctIndex:correct,options:opts};
    const res=await fetch('/api/AdminApi/quiz',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    const q=await res.json();
    eras.find(e=>e.id===eraId)?.quizQuestions.push(q);
    const listEl=document.getElementById(`quiz-list-${eraId}`);
    listEl.insertAdjacentHTML('beforeend',`
        <div class="border rounded p-3 mb-2" id="quiz-row-${q.id}">
            <div class="d-flex justify-content-between mb-2">
                <strong style="font-size:.85rem;">Q: ${esc(q.question)}</strong>
                <button class="btn btn-sm btn-outline-danger pill-btn" onclick="deleteQuiz(${q.id})">✕</button>
            </div>
            <small class="text-muted">Options: ${opts.map((o,i)=>`${i===correct?'✅':'○'} ${esc(o.text)}`).join(' | ')}</small>
        </div>`);
    toast('🧠 Question added','#198754');
}
async function deleteQuiz(id){
    if(!confirm('Delete this quiz question?'))return;
    await fetch(`/api/AdminApi/quiz/${id}`,{method:'DELETE'});
    document.getElementById(`quiz-row-${id}`)?.remove();
    toast('🗑️ Removed','#6c757d');
}

/* helper to escape html to stop xss */
function esc(str){ return (str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

/* function to show toast message */
function toast(msg, bg='#198754'){
    const el=document.getElementById('toast');
    document.getElementById('toast-msg').textContent=msg;
    el.style.background=bg;
    new bootstrap.Toast(el,{delay:2200}).show();
}

/* link color picker to text box */
function syncColorPair(pickId, hexId){
    document.getElementById(pickId).addEventListener('input', e => document.getElementById(hexId).value=e.target.value);
    document.getElementById(hexId).addEventListener('change', e => document.getElementById(pickId).value=e.target.value);
}
</script>
}

